---
import AppLayout from "../../layouts/AppLayout.astro";
import { ToasterStandalone } from "../../components/ui/toaster-standalone";
import { MasterRecipeCatalogPage } from "../../components/master-recipes/MasterRecipeCatalogPage";

// Check if user is authenticated
if (!Astro.locals.user) {
  // Redirect to login if not authenticated
  return Astro.redirect("/login");
}
---

<AppLayout title="Recipe Catalog">
  <div class="container mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <MasterRecipeCatalogPage client:load />
  </div>
  <ToasterStandalone client:load />
</AppLayout>
