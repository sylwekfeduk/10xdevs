---
import AppLayout from "@/layouts/AppLayout.astro";
import { ToasterStandalone } from "@/components/ui/toaster-standalone";
import { getLocaleFromUrl, localizedUrl, t } from "@/lib/i18n";

// Get locale from URL
const locale = getLocaleFromUrl(Astro.url);

// Check if user is authenticated
if (!Astro.locals.user) {
  return Astro.redirect("/login");
}

// Check if user is admin
const { data: profile } = await Astro.locals.supabase
  .from("profiles")
  .select("is_admin")
  .eq("user_id", Astro.locals.user.id)
  .single();

if (!profile || !profile.is_admin) {
  // Not an admin, redirect to dashboard with error
  return Astro.redirect(localizedUrl("/dashboard", locale));
}

const masterRecipesUrl = localizedUrl("/master-recipes", locale);
const createNewUrl = localizedUrl("/admin/master-recipes/new", locale);
---

<AppLayout title={t(locale, "admin.pageTitle")}>
  <div class="container mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="space-y-8">
      <!-- Admin Header -->
      <div class="bg-white/90 backdrop-blur-sm rounded-xl p-6 shadow-md border-l-4 border-l-[#9b5de5]">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">{t(locale, "admin.manageMasterRecipes")}</h1>
            <p class="text-gray-600 mt-2">{t(locale, "admin.manageMasterRecipesDescription")}</p>
          </div>
          <a
            href={createNewUrl}
            class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-[#9b5de5] text-white hover:bg-[#7b3ec7] h-10 px-4 py-2"
          >
            {t(locale, "admin.createMasterRecipe")}
          </a>
        </div>
      </div>

      <!-- Info Alert -->
      <div
        class="rounded-lg border border-[#9b5de5] bg-[#9b5de5]/5 p-4 text-[#7b3ec7] dark:border-[#9b5de5] dark:bg-[#9b5de5]/10"
      >
        <h3 class="mb-1 font-medium leading-none tracking-tight">{t(locale, "admin.adminAccess")}</h3>
        <p class="text-sm">
          {t(locale, "admin.adminAccessDescription")}
        </p>
      </div>

      <!-- Link to catalog -->
      <div class="flex gap-4">
        <a
          href={masterRecipesUrl}
          class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
        >
          {t(locale, "admin.viewCatalogUserView")}
        </a>
      </div>

      <!-- Master recipes list will go here -->
      <p class="text-gray-600">
        {t(locale, "admin.masterRecipesManagement")}
        <a href={masterRecipesUrl} class="text-[#9b5de5] underline">{t(locale, "admin.recipeCatalog")}</a>
        {t(locale, "admin.toViewFromUserPerspective")}
      </p>
    </div>
  </div>
  <ToasterStandalone client:load />
</AppLayout>