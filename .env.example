# Supabase Configuration
# Get these values from your Supabase project settings (https://app.supabase.com)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# AWS Credentials for Bedrock (for calorie counting with AI)
# Get these from AWS Console → Security Credentials → Access Keys
# When you create an access key, you'll get both values
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# AWS Session Token (required only for temporary credentials starting with ASIA)
# If your access key starts with AKIA (permanent), you don't need this
# AWS_SESSION_TOKEN=your_session_token_here

# AWS Bedrock Region (optional, defaults to eu-central-1)
AWS_BEDROCK_REGION=eu-central-1

# Optional: Supabase Service Role Key (for admin operations, testing)
# WARNING: Keep this secret! Never expose in client-side code
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key